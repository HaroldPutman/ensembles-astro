---
import { getPool, getActiveRegistrationCount } from '../lib/db';
import { Icon } from 'astro-icon/components';
import {
  cacheControlUntilNearestRegistrationOpens,
  getRegistrationOpensAt,
  isRegistrationNotYetOpen,
} from '../lib/activityStatus';
import { formatRegistrationOpensDate } from '../lib/datelib';
import { PREREGISTRATION_STORAGE_KEY } from '../lib/preregistration';

interface Props {
  activityId: string;
  kind: string;
  sizeMax?: number;
  startTimestamp?: number; // Unix timestamp in milliseconds
  registrationClosed?: boolean;
  /** When set, evaluated at request time inside this server island. */
  startDate?: string;
  registrationOpens?: string;
  registerHref?: string;
}

const {
  activityId,
  kind,
  sizeMax,
  startTimestamp,
  registrationClosed = false,
  startDate,
  registrationOpens,
  registerHref = `/register/${activityId}`,
} = Astro.props;

const registrationNotYetOpen =
  startDate !== undefined &&
  isRegistrationNotYetOpen({ startDate, registrationOpens });
const opensAt =
  startDate !== undefined
    ? getRegistrationOpensAt({ startDate, registrationOpens })
    : undefined;
const opensLabel = opensAt ? formatRegistrationOpensDate(opensAt) : 'soon';

Astro.response.headers.set(
  'Cache-Control',
  cacheControlUntilNearestRegistrationOpens([opensAt], 900)
);

// Check if class/camp has already started
const hasStarted =
  (kind === 'class' || kind === 'camp') &&
  startTimestamp &&
  startTimestamp < Date.now();

// Fetch registration count from database
let registeredCount = 0;
let error = false;

// Skip DB check if class has already started or registration has closed
if (!hasStarted && !registrationClosed) {
  try {
    const pool = getPool();
    const client = await pool.connect();
    try {
      registeredCount = await getActiveRegistrationCount(client, activityId);
    } finally {
      client.release();
    }
  } catch (e) {
    console.error('Failed to fetch activity status:', e);
    error = true;
  }
}

// If no sizeMax, there's no capacity limit (schema requires sizeMax > 0 when set)
const hasCapacity = sizeMax !== undefined;
const isFull = hasCapacity && registeredCount >= sizeMax;
const spotsRemaining = hasCapacity
  ? Math.max(0, sizeMax - registeredCount)
  : null;
const isLow =
  spotsRemaining !== null && spotsRemaining > 0 && spotsRemaining <= 3;
---

<>
  {
    hasStarted ? (
      <div class="activity-started-message">
        This {kind} has already started and is no longer open for registration.
      </div>
    ) : registrationClosed ? (
      <div class="activity-closed-message">Registration closed</div>
    ) : error ? (
      <>
        <div class="error-message">
          Sorry, we couldn't check the status of this {kind}
        </div>
        <slot />
      </>
    ) : (
      <>
        {isLow && !registrationNotYetOpen && (
          <p class="spots-low-message">
            <Icon name="mdi:alert" width="20" height="20" /> Only{' '}
            {spotsRemaining} spot{spotsRemaining === 1 ? '' : 's'} left!
          </p>
        )}

        {isFull ? (
          <div class="activity-full-message">Sorry, this {kind} is full</div>
        ) : registrationNotYetOpen ? (
          <div
            class="registration-opens-gate"
            data-kind={kind}
            data-opens-label={opensLabel}
            data-prereg-key={PREREGISTRATION_STORAGE_KEY}
          >
            <div class="activity-closed-message registration-opens-message">
              Registration opens {opensLabel}
            </div>
            <a
              href={registerHref}
              class="btn btn-primary oswald-cta preregister-btn"
              hidden
            >
              Pre-register Now
              <Icon name="mdi:arrow-right" width="20" height="20" />
            </a>
          </div>
        ) : (
          <slot />
        )}
      </>
    )
  }
</>

<script>
  import {
    PREREGISTRATION_STORAGE_KEY,
    isPreregistrationEnabled,
  } from '../lib/preregistration';

  function applyPreregistrationCtas() {
    if (!isPreregistrationEnabled()) return;
    document
      .querySelectorAll('.registration-opens-gate[data-kind="class"]')
      .forEach(gate => {
        const message = gate.querySelector('.registration-opens-message');
        const preregisterBtn = gate.querySelector('.preregister-btn');
        if (message instanceof HTMLElement) message.hidden = true;
        if (preregisterBtn instanceof HTMLElement) {
          preregisterBtn.hidden = false;
        }
      });
  }

  applyPreregistrationCtas();
  document.addEventListener('astro:page-load', applyPreregistrationCtas);

  // Server islands arrive after first paint — watch for the gate node.
  const observer = new MutationObserver(() => {
    if (document.querySelector('.registration-opens-gate[data-kind="class"]')) {
      applyPreregistrationCtas();
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
  // Stop watching after the common island load window.
  setTimeout(() => observer.disconnect(), 15000);

  // Keep the storage key referenced so the module stays aligned with the markup.
  void PREREGISTRATION_STORAGE_KEY;
</script>

<style>
  .error-message {
    text-align: center;
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: var(--radius-button);
    font-size: 0.9rem;
  }

  .spots-remaining {
    margin: 0.75rem 0;
    color: #666;
    font-size: 0.9rem;
  }

  .spots-remaining .spots-count {
    font-weight: 600;
  }

  .spots-remaining.spots-low .spots-count {
    color: #d97706;
  }

  .spots-remaining.spots-full .spots-count {
    color: #991b1b;
  }

  .spots-low-message {
    margin: 0.5rem 0 0.5rem 0;
    color: #b45309;
    font-size: 0.875rem;
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .activity-full-message {
    text-align: center;
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    background: #fee2e2;
    color: #991b1b;
    border: 2px solid #fecaca;
    border-radius: var(--radius-button);
    font-weight: 600;
  }

  .activity-started-message {
    text-align: center;
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    background: #f3f4f6;
    color: #4b5563;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-button);
  }

  .activity-closed-message {
    text-align: center;
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    background: #f3f4f6;
    color: #4b5563;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-button);
    font-weight: 600;
  }

  .registration-opens-gate {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .preregister-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .preregister-btn[hidden] {
    display: none;
  }
</style>
